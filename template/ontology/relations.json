{
  "schema_version": "2.0",
  "description": "Graph relationship types. Reprojection fails for an unregistered relation, an alias or retired relation, or an edge whose endpoints fall outside the relation's domain and range. Endpoint classes are category names, type:CLINICAL_TYPE (including narrower types), or @Resource, @Document, @Patient, @User, @OntologyCategory, @Concept and @ClinicalType. No relation establishes causality.",
  "relations": [
    {
      "relation": "ABOUT_MEDICATION",
      "semantics": "patient_report",
      "description": "A patient-reported record is about a medication. The aspect qualifier says how: a dose taken, a change, a hypothesis, a preference or a response. Causality is not established.",
      "establishes_causality": false,
      "status": "active",
      "domain": [
        "medication_administration",
        "medication_change",
        "patient_hypothesis",
        "care_preference",
        "medication_response"
      ],
      "range": [
        "type:medication_use"
      ],
      "qualifiers": {
        "aspect": {
          "required": true,
          "enum": [
            "administration",
            "change",
            "hypothesis",
            "preference",
            "response"
          ]
        }
      }
    },
    {
      "relation": "ADMINISTRATION_OF_MEDICATION",
      "semantics": "patient_report",
      "description": "Earlier name for ABOUT_MEDICATION with aspect administration.",
      "establishes_causality": false,
      "status": "alias",
      "domain": [
        "medication_administration"
      ],
      "range": [
        "type:medication_use"
      ],
      "alias_of": "ABOUT_MEDICATION",
      "alias_qualifiers": {
        "aspect": "administration"
      }
    },
    {
      "relation": "BELONGS_TO_PATIENT",
      "semantics": "ownership",
      "description": "Retired: every record carries its patient_id, so per-record patient edges are no longer projected. Earlier edges remain as history.",
      "establishes_causality": false,
      "status": "retired",
      "domain": [
        "@Resource",
        "@Document"
      ],
      "range": [
        "@Patient"
      ]
    },
    {
      "relation": "CHANGE_OF_MEDICATION",
      "semantics": "patient_report",
      "description": "Earlier name for ABOUT_MEDICATION with aspect change.",
      "establishes_causality": false,
      "status": "alias",
      "domain": [
        "medication_change"
      ],
      "range": [
        "type:medication_use"
      ],
      "alias_of": "ABOUT_MEDICATION",
      "alias_qualifiers": {
        "aspect": "change"
      }
    },
    {
